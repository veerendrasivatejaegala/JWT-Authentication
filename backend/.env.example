# Backend Production Environment Variables Template

# Server Port (Injected automatically by Render)
PORT=8080

# External MySQL Managed Database Connection
DB_URL=jdbc:mysql://your-mysql-host.com:3306/jwtdb?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Secret Key (Minimum 256-bit / 32 bytes)
JWT_SECRET=replace_with_a_strong_production_secret_key_here
JWT_EXPIRATION_MS=86400000

# Allowed Deployed Frontend Origin (Vercel App Domain)
FRONTEND_URL=https://your-app-name.vercel.app
