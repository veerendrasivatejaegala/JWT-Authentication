# Application Configuration Template (.env.example)

# MySQL Database Settings
DB_URL=jdbc:mysql://localhost:3306/jwtdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret Key (HMAC-SHA256 requires min 256 bits / 32 bytes secret)
JWT_SECRET=your_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
